# Site
NEXT_PUBLIC_SITE_URL=https://your-domain.example
NEXT_PUBLIC_OPERATOR_NAME=replace-with-legal-operator-name
NEXT_PUBLIC_CUSTOMER_SERVICE_EMAIL=replace-with-customer-service-email
NEXT_PUBLIC_ICP_NUMBER=
NEXT_PUBLIC_PUBLIC_SECURITY_NUMBER=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key

# Default AI provider, OpenAI-compatible
AI_API_KEY=replace-with-ai-api-key
AI_BASE_URL=https://api.example.com/v1
AI_MODEL_NAME=deepseek-chat
AI_REASONER_MODEL_NAME=deepseek-reasoner

# Optional: override generated answer length
AI_MAX_TOKENS=4096

# Optional: Tavily web search
TAVILY_API_KEY=replace-with-tavily-api-key

# Meditation / master mode. Only this channel is used (legacy FALLBACK name kept).
AI_MEDITATION_FALLBACK_API_KEY=
AI_MEDITATION_FALLBACK_BASE_URL=
AI_MEDITATION_FALLBACK_MODEL_NAME=claude-sonnet-4-5-20250929-thinking

# WeChat website QR login. Website application AppID/AppSecret from open.weixin.qq.com.
# Do not reuse WeChat Pay merchant keys here.
WECHAT_LOGIN_APP_ID=
WECHAT_LOGIN_APP_SECRET=

# WeChat Pay Native payment. Keep every key server-side.
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
# Exactly 32 characters, configured in WeChat Pay Merchant Platform > API Security.
WECHAT_PAY_API_V3_KEY=
# Recommended for deployment: base64 encode the complete merchant private key PEM.
WECHAT_PAY_PRIVATE_KEY_BASE64=
WECHAT_PAY_CERT_SERIAL_NO=
# WeChat Pay public key (not the merchant API certificate) and its PUB_KEY_ID_* identifier.
WECHAT_PAY_PUBLIC_KEY_BASE64=
WECHAT_PAY_PUBLIC_KEY_ID=

# Alipay computer website payment. Keep all keys server-side.
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
# Recommended for deployment: base64 encode the complete PEM text and set these two variables.
ALIPAY_PRIVATE_KEY_BASE64=
ALIPAY_PUBLIC_KEY_BASE64=
# The official key tool normally generates PKCS8 private keys.
ALIPAY_KEY_TYPE=PKCS8
# Sandbox only; leave empty in production to use the official gateway.
ALIPAY_GATEWAY=
