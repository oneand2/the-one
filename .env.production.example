# Site
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key

# Default AI provider, OpenAI-compatible
AI_API_KEY=replace-with-ai-api-key
AI_BASE_URL=https://api.example.com/v1
AI_MODEL_NAME=deepseek-chat
AI_REASONER_MODEL_NAME=deepseek-reasoner

# Optional: override generated answer length
AI_MAX_TOKENS=4096

# Optional: Tavily web search
TAVILY_API_KEY=replace-with-tavily-api-key

# Optional: meditation mode provider
AI_MEDITATION_API_KEY=
AI_MEDITATION_BASE_URL=
AI_MEDITATION_MODEL_NAME=claude-sonnet-4-5

# Optional: meditation mode fallback provider
AI_MEDITATION_FALLBACK_API_KEY=
AI_MEDITATION_FALLBACK_BASE_URL=
AI_MEDITATION_FALLBACK_MODEL_NAME=claude-sonnet-4-5-20250929-thinking

# Future payment integration placeholders. They are not used by the current code.
# WECHAT_PAY_APPID=
# WECHAT_PAY_MCH_ID=
# WECHAT_PAY_API_V3_KEY=
# WECHAT_PAY_PRIVATE_KEY_PATH=
# WECHAT_PAY_CERT_SERIAL_NO=
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY_PATH=
# ALIPAY_PUBLIC_KEY_PATH=
# ALIPAY_NOTIFY_URL=
