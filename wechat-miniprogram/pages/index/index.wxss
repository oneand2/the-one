.page {
  min-height: 100vh;
  padding: 160px 32px;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  box-sizing: border-box;
  background: #fbf9f4;
}

.emblem {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  width: 32px;
  height: 32px;
  margin-bottom: 28px;
}

.bar {
  height: 7px;
  background: #2c2c2c;
}

.title {
  font-family: "Songti SC", "STSong", serif;
  font-size: 30px;
  letter-spacing: 0.16em;
  font-weight: 400;
}

.hint {
  margin-top: 16px;
  color: #8a8175;
  font-size: 13px;
  line-height: 1.7;
  letter-spacing: 0.12em;
}
