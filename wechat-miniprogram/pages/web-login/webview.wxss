.fallback {
  min-height: 100vh;
  padding: 160rpx 48rpx 80rpx;
  box-sizing: border-box;
}

.fallback-title {
  display: block;
  font-family: "Songti SC", "STSong", serif;
  font-size: 40rpx;
  font-weight: 400;
  letter-spacing: 0.08em;
}

.fallback-hint {
  display: block;
  margin-top: 32rpx;
  color: #8a8175;
  font-size: 26rpx;
  line-height: 1.8;
}

.fallback-url {
  display: block;
  margin-top: 32rpx;
  color: #57534e;
  font-size: 24rpx;
  line-height: 1.8;
  word-break: break-all;
}

.fallback-copy,
.fallback-retry {
  min-height: 88rpx;
  margin-top: 40rpx;
  border-radius: 16rpx;
  background: #292524;
  color: #fbf9f4;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 88rpx;
}

.fallback-retry {
  margin-top: 16rpx;
  border: 1px solid #e8e3d8;
  background: transparent;
  color: #57534e;
}

.fallback-copy::after,
.fallback-retry::after {
  border: 0;
}
